# Copy to .env locally; never commit real credentials or keys.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/sitepilot
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
SITEPILOT_MODEL_URL=http://127.0.0.1:11434
# Only for private deployed Ollama services, comma-separated exact hostnames:
SITEPILOT_MODEL_ALLOWED_HOSTS=
# Allow plain HTTP only when traffic is confined to trusted private networking:
SITEPILOT_ALLOW_PRIVATE_HTTP=false
SITEPILOT_MODEL=qwen2.5:1.5b
SITEPILOT_MODEL_TIMEOUT=35
# In production, prefer false so model failures produce a clear unavailable state.
SITEPILOT_ALLOW_CLASSIFIER_FALLBACK=false
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
DEMO_SALES_EMAIL=reviewer@example.test
DEMO_SALES_PASSWORD=YOUR_LOCAL_DEMO_PASSWORD
APP_ENV=development
ENVIRONMENT=development

# Only this identity may approve project facts and change visit slots.
SALES_HEAD_EMAIL=reviewer@example.test

# Footer contact details: optional. If unset, uses an approved project contact.
SITEPILOT_PUBLIC_CONTACT_PHONE=
SITEPILOT_PUBLIC_CONTACT_EMAIL=
